{
  "name": "wavesol",
  "version": "0.0.0",
  "description": "Graph-based presentations for academic talks: nodes on one canvas, navigation along edges.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:camera": "vite spikes/camera",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "schema": "tsx scripts/gen-schema.ts",
    "schema:check": "tsx scripts/gen-schema.ts --check",
    "docs:dev": "node bin/wavesol.js dev docs",
    "docs:build": "node bin/wavesol.js build docs",
    "docs:check": "node bin/wavesol.js check docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@mdit/plugin-attrs": "^1.3.4",
    "@mdit/plugin-container": "^2.0.3",
    "@mdit/plugin-tex": "^1.1.3",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "elkjs": "^0.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "mrmime": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "sirv": "^3.0.2",
    "tsx": "^4.23.15",
    "uqr": "^0.1.3",
    "vite": "^8.3.5",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "wavesol": "bin/wavesol.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "schema",
    "relay-worker",
    "spec",
    "templates"
  ]
}
