{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "image"
    },
    "title": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "src": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "fit": {
      "type": "string",
      "enum": [
        "contain",
        "cover"
      ]
    }
  },
  "required": [
    "type",
    "src"
  ],
  "additionalProperties": false
}
