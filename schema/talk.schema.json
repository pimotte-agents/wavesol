{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "anyOf": [
        {
          "type": "string"
        },
        {}
      ]
    },
    "venue": {
      "type": "string"
    },
    "start": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "theme": {
      "type": "object",
      "properties": {
        "base": {
          "description": "Built-in theme.",
          "type": "string",
          "enum": [
            "academic-light",
            "academic-dark"
          ]
        },
        "accent": {
          "type": "string"
        },
        "vars": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "object",
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "fly",
                "cut",
                "fade",
                "zoom-through"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "fly",
                    "cut",
                    "fade",
                    "zoom-through"
                  ]
                },
                "duration": {
                  "description": "Milliseconds. Default for fly: scaled by distance.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "easing": {
                  "description": "CSS easing keyword or cubic-bezier(...).",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "layered",
            "force",
            "grid",
            "manual"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "right",
            "down",
            "left",
            "up"
          ]
        },
        "spacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wrap": {
          "description": "Layered: wrap long chains into rows (default true).",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "math": {
      "type": "object",
      "properties": {
        "macros": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "bibliography": {
      "description": "BibTeX file for [@key] citations; default refs.bib if it exists.",
      "type": "string"
    },
    "head": {
      "description": "HTML file that wavesol build adds to the page's <head>, e.g. an analytics script; wavesol dev leaves it out.",
      "type": "string"
    },
    "sync": {
      "type": "object",
      "properties": {
        "phone": {
          "description": "Phone controller (default true). false: no relay is ever contacted.",
          "type": "boolean"
        },
        "relays": {
          "description": "Relays for pairing a phone and as fallback, replacing the built-in public ones. `room:` is a self-hosted relay (Cloudflare Worker).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(mqtt|nostr|room):wss?:\\/\\/.+$"
          }
        },
        "ice": {
          "description": "Extra ICE servers for WebRTC, e.g. a TURN server; added to the default STUN servers.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "urls": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "stun:… or turn:… URL(s)"
              },
              "username": {
                "type": "string"
              },
              "credential": {
                "type": "string"
              }
            },
            "required": [
              "urls"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "pdf": {
      "description": "wavesol build also writes a PDF next to the site (needs Playwright with Chromium).",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "description": "default: talk.pdf",
              "type": "string",
              "pattern": "^[\\w.-]+\\.pdf$"
            },
            "steps": {
              "description": "last (default): a page per node; all: a page per step",
              "type": "string",
              "enum": [
                "last",
                "all"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "tikz": {
      "description": "LaTeX setup for all TikZ pictures (tikz nodes and ```tikz fences).",
      "type": "object",
      "properties": {
        "packages": {
          "description": "Extra LaTeX packages (tikz-cd is added when a picture uses it).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "libraries": {
          "description": "TikZ libraries, as for \\usetikzlibrary.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preamble": {
          "description": "Raw LaTeX preamble lines, e.g. \\definecolor.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                }
              },
              "layout": {
                "type": "object",
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "layered",
                      "force",
                      "grid",
                      "manual"
                    ]
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "right",
                      "down",
                      "left",
                      "up"
                    ]
                  },
                  "spacing": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "wrap": {
                    "description": "Layered: wrap long chains into rows (default true).",
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "pin": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "size": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "near": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "left-of": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      }
                    },
                    "required": [
                      "left-of"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "right-of": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      }
                    },
                    "required": [
                      "right-of"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "above": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      }
                    },
                    "required": [
                      "above"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "below": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      }
                    },
                    "required": [
                      "below"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "transition": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "fly",
                      "cut",
                      "fade",
                      "zoom-through"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "fly",
                          "cut",
                          "fade",
                          "zoom-through"
                        ]
                      },
                      "duration": {
                        "description": "Milliseconds. Default for fly: scaled by distance.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "easing": {
                        "description": "CSS easing keyword or cubic-bezier(...).",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": {},
            "description": "Graph and placement fields; plugin-specific fields belong in the node file's frontmatter."
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\s*[a-z0-9][a-z0-9_-]*(\\s*->\\s*[a-z0-9][a-z0-9_-]*)+\\s*$"
          },
          {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^\\s*[a-z0-9][a-z0-9_-]*(\\s*->\\s*[a-z0-9][a-z0-9_-]*)+\\s*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "default": {
                  "type": "boolean"
                },
                "transition": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "fly",
                        "cut",
                        "fade",
                        "zoom-through"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "fly",
                            "cut",
                            "fade",
                            "zoom-through"
                          ]
                        },
                        "duration": {
                          "description": "Milliseconds. Default for fly: scaled by distance.",
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "easing": {
                          "description": "CSS easing keyword or cubic-bezier(...).",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        ]
      }
    }
  },
  "required": [
    "title",
    "nodes"
  ],
  "additionalProperties": false
}
